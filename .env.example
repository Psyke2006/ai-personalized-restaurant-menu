# Environment variables for AI-Powered Personalized Restaurant Menu Backend

# Database URL: defaults to SQLite for local development; can point to PostgreSQL
DATABASE_URL=sqlite:///./menu_app.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/menu_db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Key for menu extraction/normalization (optional for core recommendation)
GEMINI_API_KEY=

# Server Environment
APP_ENV=development
